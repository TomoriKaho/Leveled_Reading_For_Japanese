# Copy this file to .env and fill values for real model calls.
# Keep .env out of git. It is already listed in .gitignore.
# mock runs locally without an API key. Use openai for real LLM calls.
SAGAP_LLM_PROVIDER=mock
# Required only when SAGAP_LLM_PROVIDER=openai.
OPENAI_API_KEY=
# Choose the model available to your API account.
SAGAP_OPENAI_MODEL=gpt-4.1-mini
# Default runtime settings.
SAGAP_OUTPUT_DIR=outputs
SAGAP_TEMPERATURE=0.2
SAGAP_MAX_OUTPUT_TOKENS=4096