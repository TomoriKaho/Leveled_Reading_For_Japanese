{
  "name": "N3 literary reader profile",
  "target_level": "N3",
  "description": "A reader who can handle everyday Japanese but needs support for modern literary prose, cultural terms, long modifiers, and ambiguous psychological description.",
  "known_vocabulary": ["私", "先生", "雨", "門", "見る", "行く", "思う", "話す", "心", "町", "人", "夜"],
  "preserve_terms": ["先生", "羅生門", "下人", "下宿"],
  "avoid_terms": ["畢竟", "邂逅", "憂鬱"],
  "replace_terms": {
    "常に": "いつも",
    "利用して": "使って",
    "邂逅": "偶然会うこと"
  },
  "annotation_terms": {
    "下宿": {
      "reading": "げしゅく",
      "explanation": "部屋を借りて住むこと。また、その家。",
      "reason": "cultural_term",
      "level_estimate": "N2+"
    },
    "羅生門": {
      "reading": "らしょうもん",
      "explanation": "平安京にあった大きな門。作品では荒れた時代や人の心の境目を感じさせる場所。",
      "reason": "cultural_and_symbolic_term",
      "level_estimate": "proper noun"
    },
    "下人": {
      "reading": "げにん",
      "explanation": "身分の低い使用人。",
      "reason": "historical_term",
      "level_estimate": "N2+"
    }
  },
  "grammar_preferred": ["〜ている", "〜ようになる", "〜ために", "〜かもしれない", "〜わけではない"],
  "grammar_avoid": ["〜ざるを得ない", "〜に際して", "〜ことなく", "〜をめぐって"],
  "allow_out_of_level_if": ["proper_noun", "cultural_term", "theme_keyword", "repeated_core_term", "character_title", "symbolic_term"],
  "sentence_max_chars": 42,
  "preferred_sentence_chars": [20, 42],
  "max_notes_per_500_chars": 5,
  "rewrite_strength": "moderate",
  "style_policy": "Keep the text literary and natural; avoid turning it into a childish summary.",
  "preserve_literary_tone": true,
  "do_not_make_childish": true
