{
  "level": "N4",
  "description": "Basic learner profile. Simple narration with limited subordinate clauses and annotations for literary keywords.",
  "max_sentence_chars": 34,
  "preferred_sentence_chars": [16, 30],
  "grammar_preferred": ["〜ている", "〜ようになる", "〜と思う", "〜ので", "〜ながら"],
  "grammar_avoid": ["〜ざるを得ない", "〜に際して", "〜ことなく", "〜をめぐって", "〜にもかかわらず"],
  "replace_terms": {
    "常に": "いつも",
    "利用して": "使って",
    "本名": "本当の名前"
  },
  "annotation_terms": {
    "鎌倉": {
      "reading": "かまくら",
      "explanation": "神奈川県にある町の名前。",
      "reason": "place_name",
      "level_estimate": "proper noun"
    },
    "罪悪感": {
      "reading": "ざいあくかん",
      "explanation": "悪いことをしたと思って、苦しくなる気持ち。",
      "reason": "theme_keyword",
      "level_estimate": "N2+"
    },
    "下宿": {
      "reading": "げしゅく",
      "explanation": "部屋を借りて住むこと。また、その家。",
      "reason": "cultural_term",
      "level_estimate": "N2+"
    }
  },
  "allow_out_of_level_if": ["proper_noun", "cultural_term", "theme_keyword", "character_title"],
  "max_notes_per_500_chars": 5,
  "preserve_literary_tone": true,
  "do_not_make_childish": true
}

