{
  "level": "N3",
  "description": "Intermediate learner profile. Bridge level: readable narrative, moderate sentence length, strict control of complex grammar.",
  "max_sentence_chars": 45,
  "preferred_sentence_chars": [20, 42],
  "grammar_preferred": ["〜ている", "〜ようになる", "〜ために", "〜かもしれない", "〜わけではない"],
  "grammar_avoid": ["〜ざるを得ない", "〜に際して", "〜ことなく", "〜をめぐって"],
  "replace_terms": {
    "常に": "いつも",
    "利用して": "使って"
  },
  "annotation_terms": {
    "鎌倉": {
      "reading": "かまくら",
      "explanation": "神奈川県にある町の名前。",
      "reason": "place_name",
      "level_estimate": "proper noun"
    },
    "罪悪感": {
      "reading": "ざいあくかん",
      "explanation": "悪いことをしたと思って、心が苦しくなる気持ち。",
      "reason": "theme_keyword",
      "level_estimate": "N2+"
    },
    "縁側": {
      "reading": "えんがわ",
      "explanation": "日本の家で、部屋の外側にある細い板の場所。",
      "reason": "cultural_term",
      "level_estimate": "N2+"
    },
    "下宿": {
      "reading": "げしゅく",
      "explanation": "部屋を借りて住むこと。また、その家。",
      "reason": "cultural_term",
      "level_estimate": "N2+"
    }
  },
  "allow_out_of_level_if": ["proper_noun", "cultural_term", "theme_keyword", "repeated_core_term", "character_title"],
  "max_notes_per_500_chars": 5,
  "preserve_literary_tone": true,
  "do_not_make_childish": true
}

