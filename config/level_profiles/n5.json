{
  "level": "N5",
  "description": "Very basic learner profile. Prefer short sentences, basic particles, and direct event narration.",
  "max_sentence_chars": 28,
  "preferred_sentence_chars": [12, 24],
  "grammar_preferred": ["です", "ます", "〜ている", "〜から", "〜ので"],
  "grammar_avoid": ["〜ざるを得ない", "〜に際して", "〜ことなく", "〜をめぐって", "〜にもかかわらず", "〜わけではない"],
  "replace_terms": {
    "常に": "いつも",
    "利用して": "使って",
    "本名": "本当の名前",
    "打ち明けない": "言わない"
  },
  "annotation_terms": {
    "鎌倉": {
      "reading": "かまくら",
      "explanation": "神奈川県にある町の名前。",
      "reason": "place_name",
      "level_estimate": "proper noun"
    },
    "先生": {
      "reading": "せんせい",
      "explanation": "ここでは、主人公が尊敬して呼んでいる人。",
      "reason": "character_title",
      "level_estimate": "N5"
    },
    "罪悪感": {
      "reading": "ざいあくかん",
      "explanation": "悪いことをしたと思って、苦しくなる気持ち。",
      "reason": "theme_keyword",
      "level_estimate": "N2+"
    }
  },
  "allow_out_of_level_if": ["proper_noun", "cultural_term", "theme_keyword", "character_title"],
  "max_notes_per_500_chars": 6,
  "preserve_literary_tone": true,
  "do_not_make_childish": true
}

